{
  "name": "chitin-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src vite.config.ts svelte.config.js --deny-warnings",
    "preview": "vite preview",
    "validate": "pnpm format:check && pnpm lint && pnpm check && pnpm build",
    "wasm:build": "wasm-pack build ../crates/chitin-wasm --target web --out-dir pkg"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.0",
    "unocss": "^66.9.2",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.5.2"
}
